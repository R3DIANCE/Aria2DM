{
  "manifest_version": 3,
  "name": "Aria2DM Browser Bridge",
  "version": "1.0.0",
  "description": "Sends clicked links and browser downloads to Aria2DM.",
  "key": "",
  "permissions": ["nativeMessaging", "downloads", "contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": [
        "*://drive.google.com/*",
        "*://mega.nz/*",
        "*://*.mega.nz/*",
        "*://www.mediafire.com/*",
        "*://mediafire.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
